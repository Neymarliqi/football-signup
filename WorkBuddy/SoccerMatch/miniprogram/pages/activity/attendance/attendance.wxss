/* pages/activity/attendance/attendance.wxss */

.container {
  background: #f5f5f5;
  min-height: 100vh;
}

.loading-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 400rpx;
}
.loading-text { color: #999; font-size: 28rpx; }

/* 分组标题 */
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #f5f5f5;
  padding: 20rpx 32rpx 12rpx;
}
.section-head-gray { margin-top: 20rpx; }

.section-label {
  font-size: 26rpx;
  color: #999;
  font-weight: 500;
}

.btn-all {
  font-size: 26rpx;
  color: #ff6b35;
}

/* 球员列表 */
.player-list { background: #fff; }

.player-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.player-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
}

.player-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #eee;
  flex-shrink: 0;
}

.player-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.player-name {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.player-time {
  font-size: 24rpx;
  color: #999;
}

/* 出勤复选框 */
.attend-checkbox {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  border: 3rpx solid #ddd;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: #fff;
}

.attend-checkbox.checked {
  background: #ff6b35;
  border-color: #ff6b35;
}

.check-icon {
  font-size: 28rpx;
  color: #fff;
  font-weight: 700;
}

/* 提示文字 */
.hint-text {
  text-align: center;
  font-size: 24rpx;
  color: #bbb;
  padding: 32rpx 32rpx;
}

/* 底部按钮 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 32rpx calc(env(safe-area-inset-bottom) + 20rpx);
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
}

.btn-submit {
  background: #ff6b35;
  color: #fff;
  border-radius: 50rpx;
  height: 90rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
}

.btn-disabled { opacity: 0.5; }
